+KEN_BURNS_EASE = 0.5         # 0 = constant speed, 1 = full ease-in/out (stops dead at both ends)
+KEN_BURNS_SUPERSAMPLE = 1.0  # working resolution multiplier; 1.5 is slightly sharper but ~2x slower
